#!/bin/bash
# systemctl stub: logs the call to $STUB_DIR/calls.log.
# Service states are "name state" lines in $STUB_DIR/services;
# the `systemctl start` exit code comes from $STUB_DIR/start.rc (0 by default).
echo "systemctl $*" >> "$STUB_DIR/calls.log"

state_of() {
    awk -v name="${1%.service}" '$1 == name { print $2; found = 1; exit } END { exit !found }' \
        "$STUB_DIR/services"
}

case "$1" in
    is-active)
        if state=$(state_of "$2"); then
            echo "$state"
            [[ $state == active ]] && exit 0
            exit 3
        fi
        echo inactive
        exit 3
        ;;
    show)
        if state_of "${!#}" > /dev/null; then echo loaded; else echo not-found; fi
        ;;
    start)
        exit "$(cat "$STUB_DIR/start.rc" 2> /dev/null || echo 0)"
        ;;
esac
exit 0
