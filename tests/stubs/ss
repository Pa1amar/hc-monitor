#!/bin/bash
# ss stub: logs the call; -ltn prints $STUB_DIR/ss_tcp.out, -lun prints $STUB_DIR/ss_udp.out;
# prints $STUB_DIR/ss.err to stderr if it exists; exits with $STUB_DIR/ss.rc (0 by default).
echo "ss $*" >> "$STUB_DIR/calls.log"
case "$1" in
    -ltn) cat "$STUB_DIR/ss_tcp.out" ;;
    -lun) cat "$STUB_DIR/ss_udp.out" ;;
esac
if [[ -f $STUB_DIR/ss.err ]]; then
    cat "$STUB_DIR/ss.err" >&2
fi
exit "$(cat "$STUB_DIR/ss.rc" 2> /dev/null || echo 0)"
